<Window x:Class="TestAtend.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TestAtend"
        Height="320"
        Width="520"
        MinHeight="260"
        MinWidth="420"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="32">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="TestAtend"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Margin="0,0,0,16" />
            <TextBlock Text="A fundacao do aplicativo desktop foi criada."
                       FontSize="16"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />
            <TextBlock Text="Captura de tela e integracao com API serao implementadas em etapas futuras."
                       FontSize="14"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
